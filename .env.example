# Copy this file to .env for local development only.
# DO NOT commit real credentials to the repository.
# For deployment (Vercel) set these in Project → Settings → Environment Variables.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional: signs admin session cookies. If unset, a built-in dev default is used.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Admin login is stored in the database (AdminUser), not in env.
# First deploy auto-creates: admin@shakalaka.com / shakalaka@123
# Change it after login via POST /api/auth/change-password
