# Copy this file to .env for local development only.
# DO NOT commit real credentials to the repository.
# For deployment (Vercel) set these in Project → Settings → Environment Variables.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Public site URL for Open Graph / Telegram / Facebook share previews (no trailing slash)
# Example: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: signs admin session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Admin login is stored in the database (AdminUser table), not in env.
